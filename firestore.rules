rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'role'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.role in ['driver', 'guard'];
      allow read, update, delete: if false;
    }
    
    match /driverLocations/{driverId} {
  allow read:  if request.auth != null;
  allow write: if request.auth != null && request.auth.uid == driverId;
}

    match /parkingLots/{lotId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /reservations/{resId} {
      allow read, write: if request.auth != null;
    }

    match /walletTransactions/{txnId} {
      allow read:   if request.auth != null && (request.auth.uid == resource.data.userId || isOwner());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read:  if request.auth != null && (request.auth.uid == userId || isOwner());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /notifications/{notifId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create:       if request.auth != null;
      allow delete:       if false;
    }

    match /chats/{reservationId}/messages/{messageId} {
      allow read, write: if request.auth != null 
        && exists(/databases/$(database)/documents/reservations/$(reservationId))
        && (request.auth.uid == get(/databases/$(database)/documents/reservations/$(reservationId)).data.driverId
        || request.auth.uid == get(/databases/$(database)/documents/reservations/$(reservationId)).data.guardId);
    }

    match /savedPlaces/{docId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if false;
    }
  }
}